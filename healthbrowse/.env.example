PORT=8080
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Used only by licensed terminology operators.
UMLS_API_KEY=
SNOMED_CT_LICENSE_CONFIRMED=false

# Server-only, authenticated HTTPS OpenAI-compatible chat completion endpoints.
# General-user hosted BASE model. These settings do not train/load an adapter.
# Supply HF_TOKEN through your server secret manager; never put it in dist/ or Git.
MODEL_GENERAL_URL=https://router.huggingface.co/v1/chat/completions
MODEL_GENERAL_ID=meta-llama/Meta-Llama-3-8B-Instruct:featherless-ai
HF_TOKEN=
# Optional explicit provider key. Takes precedence over HF_TOKEN.
MODEL_GENERAL_KEY=
# Keep this profile for a dedicated endpoint serving an evaluated Llama-3 adapter.
MODEL_GENERAL_CONTEXT_TOKENS=8192
# Clinicians remain a separate, explicitly configured route.
MODEL_PROFESSIONAL_URL=https://dr7.ai/api/v1/medical/chat/completions
MODEL_PROFESSIONAL_ID=medgemma-4b-it
# Secret DR7 API key, supplied only through the server secret manager.
MODEL_PROFESSIONAL_KEY=

# Recommended hosted integration: both General and Clinicians.
MODEL_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
# Store the real value in the server secret manager, never Git or browser code.
GROQ_API_KEY=
# Claim-support review uses openai/gpt-oss-20b on the same Groq account.
# The MODEL_GENERAL_* and MODEL_PROFESSIONAL_* settings above are legacy
# alternatives, used only when MODEL_PROVIDER is not groq.
